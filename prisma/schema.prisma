datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?
  phone     String?
  address   String?
  logo      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  customers             Customer[]
  suppliers             Supplier[]
  categories            Category[]
  products              Product[]
  brands                Brand[]
  purchases             Purchase[]
  inventoryTransactions InventoryTransaction[]
  sales                 Sale[]
  shifts                Shift[]
  activityLogs          ActivityLog[]
  expenses              Expense[]
  storeSettings         StoreSetting[]
  expenseCategories     ExpenseCategory[]
  fiscalYears           FiscalYear[]
  incomes               Income[]
  incomeCategories      IncomeCategory[]
  deletedSales          DeletedSale[]
  membershipTiers       MembershipTier[]
  rewardPointHistories  RewardPointHistory[]
  accounts              Account[]
  journalEntries        JournalEntry[]
  purchaseReturns       PurchaseReturn[]
  saleReturns           SaleReturn[]
  PaymentTransaction    PaymentTransaction[]
  unitConversions       UnitConversion[]
  userSessions          UserSession[]
  auditLogs             AuditLog[]
}

model User {
  id                    Int                    @id @default(autoincrement())
  email                 String                 @unique
  password              String
  name                  String
  roleId                Int
  role                  Role                   @relation(fields: [roleId], references: [id])
  active                Boolean                @default(true)
  failedLoginAttempts   Int                    @default(0)
  lockoutUntil          DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sales                 Sale[]
  shifts                Shift[]
  activityLogs          ActivityLog[]
  inventoryTransactions InventoryTransaction[]
  purchases             Purchase[]
  sessions              UserSession[]
  auditLogs             AuditLog[]
  companyId             Int                    @default(1)
  company               Company                @relation(fields: [companyId], references: [id])
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique // e.g. "Admin", "Cashier"
  description String?
  users       User[]
}

model Customer {
  id                   Int                  @id @default(autoincrement())
  name                 String
  email                String?
  phone                String?
  address              String?
  points               Int                  @default(0) // Loyalty points
  sales                Sale[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  walletBalance        Float                @default(0)
  membershipTierId     Int?
  membershipTier       MembershipTier?      @relation(fields: [membershipTierId], references: [id])
  rewardPointHistories RewardPointHistory[]
  companyId            Int                  @default(1)
  company              Company              @relation(fields: [companyId], references: [id])
  saleReturns          SaleReturn[]

  @@unique([phone, companyId])
  @@unique([email, companyId])
}

model Supplier {
  id                    Int                    @id @default(autoincrement())
  name                  String
  contactName           String?
  email                 String?
  phone                 String?
  address               String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  inventoryTransactions InventoryTransaction[]
  purchases             Purchase[]
  purchaseReturns       PurchaseReturn[]
  companyId             Int                    @default(1)
  company               Company                @relation(fields: [companyId], references: [id])
}

model Category {
  id            Int        @id @default(autoincrement())
  name          String
  description   String?
  image         String?    // Relative path to uploaded category image
  parentId      Int?
  parent        Category?  @relation("CategorySubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children      Category[] @relation("CategorySubCategories")
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  companyId     Int        @default(1)
  company       Company    @relation(fields: [companyId], references: [id])

  @@unique([name, companyId])
}

model Product {
  id                    Int                    @id @default(autoincrement())
  name                  String
  SKU                   String
  barcode               String?
  description           String?
  price                 Float // Selling price
  cost                  Float // Buying/Cost price
  stock                 Float                    @default(0)
  minStockAlert         Int                    @default(5)
  unit                  String                 @default("pcs") // Measurement Unit
  categoryId            Int
  category              Category               @relation(fields: [categoryId], references: [id])
  brandId               Int?
  brand                 Brand?                 @relation(fields: [brandId], references: [id])
  taxRate               Float                  @default(0.0) // E.g. 13.0 for 13% tax
  image                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  saleItems             SaleItem[]
  inventoryTransactions InventoryTransaction[]
  purchaseItems         PurchaseItem[]
  companyId             Int                    @default(1)
  company               Company                @relation(fields: [companyId], references: [id])
  unitConversions       UnitConversion[]

  @@unique([SKU, companyId])
  @@unique([barcode, companyId])
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String
  status    String    @default("ACTIVE") // ACTIVE, INACTIVE
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  companyId Int       @default(1)
  company   Company   @relation(fields: [companyId], references: [id])

  @@unique([name, companyId])
  @@unique([slug, companyId])
}

model Purchase {
  id              Int              @id @default(autoincrement())
  poNumber        String // e.g., "PO-2026-0001"
  supplierId      Int?
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  status          String           @default("RECEIVED") // PENDING, RECEIVED
  totalAmount     Float
  purchaseDate    DateTime         @default(now()) // Purchase Date
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           PurchaseItem[]
  userId          Int // Who created it
  user            User             @relation(fields: [userId], references: [id])
  purchaseReturns PurchaseReturn[]
  companyId       Int              @default(1)
  company         Company          @relation(fields: [companyId], references: [id])

  @@unique([poNumber, companyId])
}

model PurchaseItem {
  id                  Int                  @id @default(autoincrement())
  purchaseId          Int
  purchase            Purchase             @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId           Int
  product             Product              @relation(fields: [productId], references: [id])
  quantity            Float
  measurementUnit     String               @default("pcs") // Measurement Unit at time of purchase
  costPrice           Float // cost per unit at the time of purchase
  total               Float
  saleUnit            String?
  saleUnitQuantity    Float?
  purchaseReturnItems PurchaseReturnItem[]
}

model InventoryTransaction {
  id         Int       @id @default(autoincrement())
  productId  Int
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       String // "STOCK_IN", "STOCK_OUT"
  quantity   Float
  reason     String? // e.g. "Purchase", "Sale", "Damage", "Return"
  supplierId Int?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  userId     Int?
  user       User?     @relation(fields: [userId], references: [id])
  createdAt  DateTime  @default(now())
  companyId  Int       @default(1)
  company    Company   @relation(fields: [companyId], references: [id])
}

model Sale {
  id                 Int                 @id @default(autoincrement())
  invoiceNo          String // e.g. "INV-2026-0001"
  customerId         Int?
  customer           Customer?           @relation(fields: [customerId], references: [id])
  cashierId          Int
  cashier            User                @relation(fields: [cashierId], references: [id])
  subtotal           Float
  taxAmount          Float
  discountAmount     Float
  totalAmount        Float
  paymentMethod      String // "CASH", "CARD", "QR"
  paymentStatus      String // "PAID", "PARTIAL", "UNPAID"
  items              SaleItem[]
  createdAt          DateTime            @default(now())
  companyId          Int                 @default(1)
  company            Company             @relation(fields: [companyId], references: [id])
  PaymentTransaction PaymentTransaction?
  saleReturns        SaleReturn[]

  @@unique([invoiceNo, companyId])
}

model SaleItem {
  id              Int              @id @default(autoincrement())
  saleId          Int
  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product          @relation(fields: [productId], references: [id])
  quantity        Float
  price           Float // Selling price at the time of sale
  cost            Float // Product cost at the time of sale (for profit reports)
  taxAmount       Float
  total           Float
  saleUnit        String?  // e.g., "Gram"
  saleUnitQuantity Float?  // e.g., 250
  saleReturnItems SaleReturnItem[]
}

model Shift {
  id         Int       @id @default(autoincrement())
  employeeId Int
  employee   User      @relation(fields: [employeeId], references: [id])
  startTime  DateTime  @default(now())
  endTime    DateTime?
  cashStart  Float
  cashEnd    Float?
  status     String    @default("OPEN") // "OPEN", "CLOSED"
  createdAt  DateTime  @default(now())
  companyId  Int       @default(1)
  company    Company   @relation(fields: [companyId], references: [id])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String // e.g. "DELETE_PRODUCT", "MANUAL_STOCK_ADJUST"
  details   String?
  timestamp DateTime @default(now())
  companyId Int      @default(1)
  company   Company  @relation(fields: [companyId], references: [id])
}

model Expense {
  id          Int      @id @default(autoincrement())
  referenceNo String?
  category    String // "OPERATIONAL", "CAPITAL", "UNEXPECTED", or custom categories
  amount      Float
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   Int      @default(1)
  company     Company  @relation(fields: [companyId], references: [id])
}

model StoreSetting {
  id             Int      @id @default(autoincrement())
  storeName      String   @default("SmartPOS Retail")
  address        String   @default("123 Business St, Tech City")
  phone          String   @default("+1 555-0199")
  email          String   @default("info@smartpos.com")
  taxNumber      String   @default("TAX-987654321")
  currencySymbol String   @default("Rs.")
  receiptHeader  String   @default("Thank you for shopping with us!")
  receiptFooter  String   @default("Please come again! Power by SmartPOS.")
  taxRateDefault Float    @default(13.0)
  invoicePrefix  String   @default("PTRM")
  printCopies    Int      @default(2)
  updatedAt      DateTime @updatedAt
  companyId      Int      @default(1)
  company        Company  @relation(fields: [companyId], references: [id])
}

model ExpenseCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   Int      @default(1)
  company     Company  @relation(fields: [companyId], references: [id])
}

model FiscalYear {
  id        Int       @id @default(autoincrement())
  name      String // e.g. "2080/081"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean   @default(false)
  isClosed  Boolean   @default(false)
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  companyId Int       @default(1)
  company   Company   @relation(fields: [companyId], references: [id])

  @@unique([name, companyId])
}

model Income {
  id          Int      @id @default(autoincrement())
  referenceNo String?
  category    String // "EXPORT_FEE", "SERVICE_CHARGE", "OTHER" or custom
  amount      Float
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   Int      @default(1)
  company     Company  @relation(fields: [companyId], references: [id])
}

model IncomeCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyId   Int      @default(1)
  company     Company  @relation(fields: [companyId], references: [id])
}

model DeletedSale {
  id             Int      @id @default(autoincrement())
  originalSaleId Int // Original Sale ID before deletion
  invoiceNo      String
  customerName   String?
  cashierName    String?
  totalAmount    Float
  itemsSnapshot  String // JSON string of items
  deletedAt      DateTime @default(now())
  deletedById    Int // Admin who deleted it
  companyId      Int      @default(1)
  company        Company  @relation(fields: [companyId], references: [id])
}

// =========================
// CRM MODULE
// =========================

model MembershipTier {
  id              Int        @id @default(autoincrement())
  name            String
  minPoints       Int        @default(0)
  discountPercent Float      @default(0)
  customers       Customer[]
  companyId       Int        @default(1)
  company         Company    @relation(fields: [companyId], references: [id])
}

model RewardPointHistory {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points     Int // Can be negative if spent
  reason     String? // e.g., "Earned from Sale", "Spent on Purchase"
  createdAt  DateTime @default(now())
  companyId  Int      @default(1)
  company    Company  @relation(fields: [companyId], references: [id])
}

// =========================
// ACCOUNTING MODULE
// =========================

model Account {
  id          Int     @id @default(autoincrement())
  code        String // e.g. "1000", "2000"
  name        String // e.g. "Cash", "Accounts Receivable"
  type        String // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  balance     Float   @default(0) // Running balance (optional, usually calculated)
  description String?

  journalLines JournalEntryLine[]
  companyId    Int                @default(1)
  company      Company            @relation(fields: [companyId], references: [id])
}

model JournalEntry {
  id          Int      @id @default(autoincrement())
  referenceNo String? // e.g. "INV-001", "PO-002"
  description String
  date        DateTime @default(now())

  lines     JournalEntryLine[]
  companyId Int                @default(1)
  company   Company            @relation(fields: [companyId], references: [id])
}

model JournalEntryLine {
  id             Int          @id @default(autoincrement())
  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      Int
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Float        @default(0)
  credit         Float        @default(0)
  description    String?
}

// =========================
// PURCHASE ENHANCEMENTS
// =========================

model PurchaseReturn {
  id          Int                  @id @default(autoincrement())
  returnNo    String
  purchaseId  Int
  purchase    Purchase             @relation(fields: [purchaseId], references: [id])
  supplierId  Int?
  supplier    Supplier?            @relation(fields: [supplierId], references: [id])
  reason      String?
  totalAmount Float
  returnDate  DateTime             @default(now())
  createdAt   DateTime             @default(now())
  companyId   Int                  @default(1)
  company     Company              @relation(fields: [companyId], references: [id])
  items       PurchaseReturnItem[]

  @@unique([returnNo, companyId])
}

model PurchaseReturnItem {
  id               Int            @id @default(autoincrement())
  purchaseReturnId Int
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  purchaseItemId   Int
  purchaseItem     PurchaseItem   @relation(fields: [purchaseItemId], references: [id])
  quantity         Float
  refundAmount     Float
}

// =========================
// SALES ENHANCEMENTS
// =========================

model SaleReturn {
  id          Int              @id @default(autoincrement())
  returnNo    String
  saleId      Int
  sale        Sale             @relation(fields: [saleId], references: [id])
  customerId  Int?
  customer    Customer?        @relation(fields: [customerId], references: [id])
  reason      String?
  totalAmount Float
  returnDate  DateTime         @default(now())
  createdAt   DateTime         @default(now())
  companyId   Int              @default(1)
  company     Company          @relation(fields: [companyId], references: [id])
  items       SaleReturnItem[]

  @@unique([returnNo, companyId])
}

model SaleReturnItem {
  id           Int        @id @default(autoincrement())
  saleReturnId Int
  saleReturn   SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItemId   Int
  saleItem     SaleItem   @relation(fields: [saleItemId], references: [id])
  quantity     Float
  refundAmount Float
}

// =========================
// PAYMENT GATEWAY MODULE
// =========================

model PaymentTransaction {
  id             Int      @id @default(autoincrement())
  saleId         Int?     @unique
  sale           Sale?    @relation(fields: [saleId], references: [id])
  provider       String // "STRIPE", "ESEWA", "KHALTI"
  transactionRef String   @unique // External gateway reference ID
  amount         Float
  status         String   @default("PENDING") // PENDING, SUCCESS, FAILED
  paymentDate    DateTime @default(now())
  createdAt      DateTime @default(now())
  companyId      Int      @default(1)
  company        Company  @relation(fields: [companyId], references: [id])
}

// =========================
// UNIT CONVERSION MODULE
// =========================

model UnitConversion {
  id               Int      @id @default(autoincrement())
  baseUnit         String   // e.g., "KG", "Dozen", "Box"
  secondaryUnit    String   // e.g., "Gram", "Piece"
  conversionFactor Float    // e.g., 1000 (1 Base = 1000 Secondary)
  
  productId        Int?     
  product          Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  companyId        Int      @default(1)
  company          Company  @relation(fields: [companyId], references: [id])
}

// =========================
// SESSION & SECURITY MODULE
// =========================

model UserSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  companyId    Int      @default(1)
  company      Company  @relation(fields: [companyId], references: [id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g., "CREATE_PRODUCT", "UPDATE_PRODUCT", "LOGIN", "FAILED_LOGIN"
  resource   String   // e.g., "products", "users", "auth"
  resourceId String?  // e.g., "12"
  details    String?  // JSON string or summary
  ipAddress  String?
  createdAt  DateTime @default(now())
  companyId  Int      @default(1)
  company    Company  @relation(fields: [companyId], references: [id])
}
